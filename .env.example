# Core Authentication
# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=your-auth-secret-here

# Database - Neon
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_token

# AI Providers
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GROQ_API_KEY=gsk_xxx
OPENROUTER_API_KEY=sk-or-xxx
XAI_API_KEY=xai-xxx
COHERE_API_KEY=co-xxx
REPLICATE_API_TOKEN=r8_xxx
HUGGINGFACE_API_KEY=hf_xxx
TOGETHER_API_KEY=xxx
PERPLEXITY_API_KEY=pplx-xxx
MISTRAL_API_KEY=xxx
FIREWORKS_API_KEY=fw_xxx

# AI Gateway
# AI Gateway API Key (required for non-Vercel deployments)
# For Vercel deployments, OIDC tokens are used automatically
AI_GATEWAY_API_KEY=xxx
VERCEL_AI_GATEWAY_URL=https://gateway.ai.vercel.com

# Integrations
FAL_KEY=fal_xxx
RESEND_API_KEY=re_xxx
SERPAPI_API_KEY=xxx
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx

# Feature Flags
ENABLE_GUARDRAILS=true
ENABLE_WEB_SEARCH=true
ENABLE_IMAGE_GENERATION=true
